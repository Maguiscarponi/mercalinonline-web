# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# base de datos local de desarrollo (prod usa Supabase Postgres)
/dev.db
/dev.db-journal
/dev.db-shm
/dev.db-wal

# imágenes subidas desde el admin en desarrollo local (prod usa Supabase Storage)
/public/uploads/

# código viejo de landing pages descartadas, no se llegó a borrar del disco
/_to_delete/

# typescript
*.tsbuildinfo
next-env.d.ts
